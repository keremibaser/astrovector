# AI'A NOT: ÜRETİM ortam değişkenleri ÖRNEĞİ. Gerçek dosya `.env.production` olarak kopyalanır ve
# ASLA repoya/imaja girmez (.gitignore + .dockerignore kapsamında). ADMIN_SECRET_KEY'i buraya YAZMA;
# sunucuda üret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=BURAYA_YENI_RASTGELE_ANAHTAR
PORT_GAME=8081
PORT_ADMIN=8090
# Yayında admin DIŞARI KAPALI kalır (yerel + SSH tüneli). Bunu değiştirmek = Tanrı Modu'nu internete açmak.
ADMIN_BIND=127.0.0.1
GAME_BIND=0.0.0.0
